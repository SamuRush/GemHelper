<Window x:Class="Gem.UI.OverlayWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Gem.UI"
        Title="JARVIS Arc Reactor"
        Width="220" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        MouseDown="Window_MouseDown"
        MouseDoubleClick="Window_MouseDoubleClick">

    <Grid x:Name="ReactorRoot" HorizontalAlignment="Center" VerticalAlignment="Center" Width="220" Height="220">
        <!-- Holographic JARVIS Arc Reactor (Layer 1, Layer 2, Layer 3 60 FPS DrawingVisual) -->
        <ui:ArcReactorVisualHost x:Name="ArcReactor"
                                 Width="216" Height="216"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Cursor="Hand"
                                 ToolTip="Левый клик: перетащить | Двойной клик: настройки | Правый клик: меню">
            <ui:ArcReactorVisualHost.Effect>
                <DropShadowEffect x:Name="OuterGlow" Color="#00E5FF" BlurRadius="26" ShadowDepth="0" Opacity="0.95"/>
            </ui:ArcReactorVisualHost.Effect>

            <!-- ContextMenu directly on the Arc Reactor core -->
            <ui:ArcReactorVisualHost.ContextMenu>
                <ContextMenu Background="#16161A" Foreground="#FFFFFF" BorderBrush="#00E5FF" BorderThickness="1">
                    <MenuItem Header="⚙ Настройки JARVIS" Click="ContextMenuSettings_Click" Foreground="#00E5FF" FontWeight="SemiBold"/>
                    <Separator Background="#33FFFFFF"/>
                    <MenuItem Header="❌ Закрыть JARVIS" Click="ContextMenuClose_Click" Foreground="#FF5555"/>
                </ContextMenu>
            </ui:ArcReactorVisualHost.ContextMenu>
        </ui:ArcReactorVisualHost>

        <!-- Mini-panel for active timers (bottom badge of core) -->
        <Border x:Name="TimerOverlayBorder"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Background="#D916161A"
                BorderBrush="#66FFD600"
                BorderThickness="1"
                CornerRadius="6"
                Padding="6,2"
                Visibility="Collapsed">
            <TextBlock x:Name="TimerOverlayText"
                       Foreground="#FFD600"
                       FontSize="10"
                       FontFamily="Consolas, Segoe UI"
                       FontWeight="SemiBold"
                       Text="⏱ 00:00"/>
        </Border>

        <!-- Speech Subtitle Popup anchored below the Arc Reactor -->
        <Popup x:Name="SpeechSubtitlePopup"
               PlacementTarget="{Binding ElementName=ArcReactor}"
               Placement="Bottom"
               AllowsTransparency="True"
               IsOpen="False"
               VerticalOffset="8">
            <Border x:Name="SpeechSubtitleBorder"
                    Background="#D916161A"
                    BorderBrush="#3300E5FF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,5"
                    MaxWidth="260"
                    Opacity="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.8"/>
                </Border.Effect>
                <TextBlock x:Name="SpeechSubtitleText"
                           Foreground="#E0FFFFFF"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="240"
                           Text=""/>
            </Border>
        </Popup>
    </Grid>
</Window>
