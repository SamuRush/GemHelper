<Window x:Class="Gem.UI.OverlayWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS Overlay"
        Width="110" Height="110"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        MouseDown="Window_MouseDown"
        MouseDoubleClick="Window_MouseDoubleClick">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Strictly round HUD Sphere container (Square container & gear removed per redesign) -->
        <Border x:Name="OuterSphere"
                Width="80" Height="80"
                CornerRadius="40"
                Background="#D916161A"
                BorderBrush="#3300E5FF"
                BorderThickness="1.5"
                SnapsToDevicePixels="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Cursor="Hand"
                ToolTip="Левый клик: перетащить | Двойной клик: настройки | Правый клик: меню">

            <Border.Effect>
                <DropShadowEffect x:Name="OuterGlow" Color="#00E5FF" BlurRadius="22" ShadowDepth="0" Opacity="0.9"/>
            </Border.Effect>

            <!-- ContextMenu directly on the sphere for settings and actions -->
            <Border.ContextMenu>
                <ContextMenu Background="#16161A" Foreground="#FFFFFF" BorderBrush="#00D2FF" BorderThickness="1">
                    <MenuItem Header="⚙ Настройки JARVIS" Click="ContextMenuSettings_Click" Foreground="#00E5FF" FontWeight="SemiBold"/>
                    <Separator Background="#33FFFFFF"/>
                    <MenuItem Header="❌ Закрыть JARVIS" Click="ContextMenuClose_Click" Foreground="#FF5555"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- Outer soft aura glow -->
                <Ellipse x:Name="AuraGlow"
                         Width="56" Height="56"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="AuraColor1" Color="#00D2FF" Offset="0.0"/>
                            <GradientStop x:Name="AuraColor2" Color="#0066CC" Offset="0.6"/>
                            <GradientStop Color="#00000000" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect x:Name="AuraBlur" Radius="12"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Center digital core / sphere -->
                <Ellipse x:Name="CoreSphere"
                         Width="42" Height="42"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="CoreScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.35,0.35" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop x:Name="CoreStopHighlight" Color="#E6FFFF" Offset="0.0"/>
                            <GradientStop x:Name="CoreStopPrimary" Color="#00D2FF" Offset="0.35"/>
                            <GradientStop x:Name="CoreStopSecondary" Color="#0055AA" Offset="0.75"/>
                            <GradientStop x:Name="CoreStopDark" Color="#001833" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Inner pulsating / RMS waveform ring -->
                <Ellipse x:Name="InnerRing"
                         Width="30" Height="30"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="#80FFFFFF" StrokeThickness="1.5"
                         Opacity="0.4"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="RingScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <!-- Mini-panel for active timers (bottom badge of core) -->
                <Border x:Name="TimerOverlayBorder"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,4"
                        Background="#D916161A"
                        BorderBrush="#66FFD600"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4,1"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TimerOverlayText"
                               Foreground="#FFD600"
                               FontSize="9"
                               FontFamily="Consolas, Segoe UI"
                               FontWeight="SemiBold"
                               Text="⏱ 00:00"/>
                </Border>
            </Grid>
        </Border>

        <!-- Speech Subtitle Popup anchored below the sphere -->
        <Popup x:Name="SpeechSubtitlePopup"
               PlacementTarget="{Binding ElementName=OuterSphere}"
               Placement="Bottom"
               AllowsTransparency="True"
               IsOpen="False"
               VerticalOffset="6">
            <Border x:Name="SpeechSubtitleBorder"
                    Background="#D916161A"
                    BorderBrush="#3300E5FF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,4"
                    MaxWidth="240"
                    Opacity="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.8"/>
                </Border.Effect>
                <TextBlock x:Name="SpeechSubtitleText"
                           Foreground="#E0FFFFFF"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="224"
                           Text=""/>
            </Border>
        </Popup>
    </Grid>
</Window>
