<Window x:Class="Gem.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки JARVIS"
        Width="640" Height="700"
        MinWidth="580" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#121217"
        Foreground="#ECECF1"
        FontFamily="Segoe UI, Arial"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Windows 11 Dark Input Box Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C24"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#323242"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#00D2FF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4C4C60"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter TargetName="border" Property="Background" Value="#22222E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#22222E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#38384C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2E2E3E"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00D2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#181822"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0086E6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1084D9"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#006CBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Group Header -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00D2FF"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9E9EB2"/>
            <Setter Property="Margin" Value="0,6,0,4"/>
        </Style>

        <!-- Sci-Fi Dark TabControl and TabItem Styles -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#181822"/>
            <Setter Property="Foreground" Value="#A0A0B8"/>
            <Setter Property="BorderBrush" Value="#2A2A38"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6,6,0,0"
                                Margin="0,0,4,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#222232"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#1E2838"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox ToggleButton Style -->
        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="templateRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Border x:Name="splitBorder"
                                    Width="28"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="arrow"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="#A0A0B8"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateRoot" Property="Background" Value="#252534"/>
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter TargetName="arrow" Property="Fill" Value="#00D2FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="templateRoot" Property="Background" Value="#20202E"/>
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter TargetName="arrow" Property="Fill" Value="#00D2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Contrast Sci-Fi ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="3,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1F3854"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#173554"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="itemBorder" Property="Background" Value="#254A70"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Sci-Fi ComboBox Style with Dark Popup & High Contrast -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1C1C24"/>
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="BorderBrush" Value="#323242"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Style="{StaticResource ComboBoxToggleButtonStyle}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   VerticalOffset="3"
                                   Focusable="False">
                                <Border x:Name="dropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#161922"
                                        BorderBrush="#00D2FF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True"
                                        Margin="0,2,0,4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.75" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer x:Name="DropDownScrollViewer" Margin="3" Padding="1">
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="dropDownBorder" Property="MinHeight" Value="56"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="True">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#00D2FF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="#00D2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GridView Column Header Style -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#242432"/>
            <Setter Property="Foreground" Value="#00D2FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#323242"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- ListView Item Style -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#22222E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#262636"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1E385B"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#00D2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⚙ Настройки JARVIS" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Конфигурация аудио и микрофона, нейросети, игр Steam и системных служб"
                       FontSize="12" Foreground="#88889C" Margin="0,3,0,0"/>
            <Separator Background="#262634" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Sci-Fi Tabs Architecture -->
        <TabControl Grid.Row="1" x:Name="MainTabs">
            <!-- TAB 1: АУДИО И МИКРОФОН -->
            <TabItem Header="🎙 Аудио и Микрофон">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,8,12,8">
                    <StackPanel>
                        <!-- Recording Device Section -->
                        <TextBlock Text="📡 Устройство записи звука (Микрофон)" Style="{StaticResource GroupHeaderStyle}"/>
                        <TextBlock Text="Выберите рабочий микрофон (NAudio WaveInEvent):" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbAudioDevices" Grid.Column="0" SelectionChanged="CmbAudioDevices_SelectionChanged"/>
                            <Button x:Name="BtnRefreshDevices" Content="🔄 Обновить" Grid.Column="1" Margin="8,0,0,0" Click="BtnRefreshDevices_Click"/>
                        </Grid>

                        <!-- Noise Gate Sensitivity Slider -->
                        <TextBlock Text="🎚 Чувствительность шумового порога (NoiseGate RMS)" Style="{StaticResource GroupHeaderStyle}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Порог отсечения тишины (50 - 600 RMS):" Style="{StaticResource FieldLabelStyle}" Grid.Column="0"/>
                            <TextBlock x:Name="TxtNoiseGateVal" Text="350 RMS" Foreground="#00E5FF" FontWeight="Bold" FontSize="13" Grid.Column="1"/>
                        </Grid>
                        <Slider x:Name="SldNoiseGate" Minimum="50" Maximum="600" Value="350"
                                TickFrequency="25" IsSnapToTickEnabled="False"
                                Margin="0,2,0,4" ValueChanged="SldNoiseGate_ValueChanged"/>
                        <TextBlock Text="Сигнал тише порога отсекается как фоновый шум комнаты. Если Джарвис не слышит микрофон, сдвиньте слайдер влево (уменьшите порог)."
                                   FontSize="11" Foreground="#88889C" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Real-time VU-Meter Signal Indicator -->
                        <TextBlock Text="📊 Индикатор уровня звука в реальном времени (VU-метр)" Style="{StaticResource GroupHeaderStyle}"/>
                        <Border Background="#1A1A24" BorderBrush="#323242" BorderThickness="1" CornerRadius="6" Padding="8,8" Margin="0,0,0,4">
                            <StackPanel>
                                <ProgressBar x:Name="PrgAudioLevel" Minimum="0" Maximum="600" Value="0" Height="14"
                                             Foreground="#00E5FF" Background="#121218" BorderThickness="0"/>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock x:Name="TxtVuLevel" Text="Текущий уровень: 0 RMS" FontSize="11" Foreground="#00FFAA" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtVuStatus" Text="Статус: Ожидание сигнала" FontSize="11" Foreground="#A0A0B8" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Произнесите фразу в микрофон: индикатор должен превышать установленный порог чувствительности."
                                   FontSize="11" Foreground="#88889C" Margin="0,0,0,14"/>

                        <!-- TTS Engine and Voice Selection -->
                        <TextBlock Text="🔊 Синтез речи (TTS) и голос Джарвиса" Style="{StaticResource GroupHeaderStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Движок синтеза речи:" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbTtsEngine" SelectionChanged="CmbTtsEngine_SelectionChanged">
                                    <ComboBoxItem Content="Edge-TTS (Онлайн нейросеть Microsoft)"/>
                                    <ComboBoxItem Content="SAPI5 (Офлайн Windows / System.Speech)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Выбор голоса:" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbTtsVoice"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnTestVoice" Content="🔊 Проверить голос" Grid.Column="0" Click="BtnTestVoice_Click"/>
                            <TextBlock Text="Быстрая проверка воспроизведения речи выбранным движком"
                                       FontSize="11" Foreground="#88889C" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ -->
            <TabItem Header="🧠 Искусственный интеллект">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,8,12,8">
                    <StackPanel>
                        <TextBlock Text="🤖 Модель и Сервер (LM Studio / OpenAI API)" Style="{StaticResource GroupHeaderStyle}"/>
                        <TextBlock Text="API Base URL (например, http://127.0.0.1:1234/v1):" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtLlmUrl" Text="http://127.0.0.1:1234/v1" Margin="0,0,0,8"/>

                        <TextBlock Text="Имя модели в LM Studio:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtLlmModel" Text="qwen2.5-1.5b-instruct" Margin="0,0,0,8"/>

                        <TextBlock Text="API Key (для локальной LM Studio можно оставить 'lm'):" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtLlmApiKey" Text="lm" Margin="0,0,0,12"/>

                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnTestLlm" Content="⚡ Проверить подключение" Grid.Column="0" Click="BtnTestLlm_Click"/>
                            <TextBlock x:Name="TxtLlmStatus" Text="" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: ИГРЫ И STEAM -->
            <TabItem Header="🎮 Игры и Steam">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,8,12,8">
                    <StackPanel>
                        <TextBlock Text="🎮 Привязка игр Steam (Ключ команды → Steam AppID)" Style="{StaticResource GroupHeaderStyle}"/>
                        <TextBlock Text="Позволяет добавлять новые игры и команды без изменения кода C#."
                                   FontSize="11" Foreground="#88889C" Margin="0,0,0,8"/>

                        <Border Background="#1A1A24" BorderBrush="#323242" BorderThickness="1" CornerRadius="6" Height="220">
                            <ListView x:Name="LstSteamGames"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="#FFFFFF"
                                      SelectionMode="Single"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Ключ вызова команды" Width="280" DisplayMemberBinding="{Binding Key}"/>
                                        <GridViewColumn Header="Steam AppID" Width="180" DisplayMemberBinding="{Binding Value}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <!-- Add new game controls -->
                        <Grid Margin="0,10,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Новый ключ команды:" Style="{StaticResource FieldLabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="Steam AppID:" Style="{StaticResource FieldLabelStyle}" Grid.Column="1" Margin="4,6,0,4"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtNewGameKey" Grid.Column="0" Margin="0,0,8,0" ToolTip="Ключ вызова (напр. 'киберпанк')"/>
                            <TextBox x:Name="TxtNewGameAppId" Grid.Column="1" Margin="0,0,8,0" ToolTip="AppID игры в Steam (напр. '1091500')"/>
                            <Button Content="➕ Добавить" Grid.Column="2" Margin="0,0,8,0" Click="BtnAddGame_Click"/>
                            <Button Content="🗑 Удалить" Grid.Column="3" Click="BtnRemoveGame_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: СИСТЕМА -->
            <TabItem Header="⚙️ Система">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,8,12,8">
                    <StackPanel>
                        <!-- Weather -->
                        <TextBlock Text="🌤 Погода (Open-Meteo)" Style="{StaticResource GroupHeaderStyle}"/>
                        <TextBlock Text="Город по умолчанию:" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtCityName" Text="Санкт-Петербург" Margin="0,0,0,4"/>
                        <TextBlock Text="Координаты и прогноз определяются автоматически при сохранении."
                                   FontSize="11" Foreground="#88889C" Margin="0,0,0,12"/>

                        <!-- Vosk Model Path -->
                        <TextBlock Text="📁 Модель распознавания Vosk" Style="{StaticResource GroupHeaderStyle}"/>
                        <TextBlock Text="Путь к каталогу модели Vosk:" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtVoskPath" Text="./model" Grid.Column="0"/>
                            <Button Content="Обзор..." Grid.Column="1" Margin="8,0,0,0" Click="BtnBrowseVosk_Click"/>
                        </Grid>

                        <!-- Windows Autorun -->
                        <TextBlock Text="🚀 Автозапуск Windows" Style="{StaticResource GroupHeaderStyle}"/>
                        <CheckBox x:Name="ChkAutoStart" Content="Запускать JARVIS автоматически при старте Windows"
                                  Foreground="#ECECF1" FontSize="13" Margin="0,4,0,14"/>

                        <!-- Hotkeys & Gestures Info -->
                        <TextBlock Text="⌨️ Горячие клавиши и управление виджетом" Style="{StaticResource GroupHeaderStyle}"/>
                        <Border Background="#1A1A24" BorderBrush="#323242" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="• Двойной клик на сферу: Открыть это окно настроек" FontSize="12" Foreground="#C8C8DC" Margin="0,2"/>
                                <TextBlock Text="• Правый клик на сферу: Контекстное меню (Настройки, Закрыть)" FontSize="12" Foreground="#C8C8DC" Margin="0,2"/>
                                <TextBlock Text="• Зажатие левой кнопки: Свободное перемещение виджета по экрану" FontSize="12" Foreground="#C8C8DC" Margin="0,2"/>
                                <TextBlock Text="• Голосовой запрос: 'джарвис &lt;команда&gt;', 'пауза', 'громкость 50', 'погода', 'закройся'" FontSize="12" Foreground="#00FFAA" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: ВИЗУАЛИЗАТОР (HUD) -->
            <TabItem Header="🎛 Визуализатор (HUD)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,8,12,8">
                    <StackPanel>
                        <TextBlock Text="🎛 Настройка эффектов и FFT-эквалайзера HUD" Style="{StaticResource GroupHeaderStyle}"/>
                        <TextBlock Text="Управление чувствительностью спектрографа, динамикой ядра и цветовыми темами реактора."
                                   FontSize="11" Foreground="#88889C" Margin="0,0,0,12"/>

                        <!-- Spectrum Gain Slider -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Чувствительность спектра (Gain):" Style="{StaticResource FieldLabelStyle}" Grid.Column="0"/>
                            <TextBlock x:Name="TxtHudGainVal" Text="3.5x" Foreground="#00E5FF" FontWeight="Bold" FontSize="13" Grid.Column="1"/>
                        </Grid>
                        <Slider x:Name="SldHudGain" Minimum="1.0" Maximum="15.0" Value="3.5"
                                TickFrequency="0.5" IsSnapToTickEnabled="False"
                                Margin="0,2,0,4" ValueChanged="HudSetting_ValueChanged"/>
                        <TextBlock Text="Масштабирует логарифмические полосы FFT, чтобы лучи эквалайзера колебались выразительно и высоко (до 15.0x на максимум окна)."
                                   FontSize="11" Foreground="#88889C" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Bass Scale Slider -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Реакция ядра на бас (Bass Scale):" Style="{StaticResource FieldLabelStyle}" Grid.Column="0"/>
                            <TextBlock x:Name="TxtHudBassVal" Text="1.40x" Foreground="#00E5FF" FontWeight="Bold" FontSize="13" Grid.Column="1"/>
                        </Grid>
                        <Slider x:Name="SldHudBassScale" Minimum="1.0" Maximum="3.0" Value="1.4"
                                TickFrequency="0.1" IsSnapToTickEnabled="False"
                                Margin="0,2,0,4" ValueChanged="HudSetting_ValueChanged"/>
                        <TextBlock Text="Настраивает силу расширения центрального шара и плазменного ядра от суб-баса (20-150 Гц, от 1.0x до 3.0x)."
                                   FontSize="11" Foreground="#88889C" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Falloff Slider -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Плавность спада (Falloff):" Style="{StaticResource FieldLabelStyle}" Grid.Column="0"/>
                            <TextBlock x:Name="TxtHudFalloffVal" Text="0.88" Foreground="#00E5FF" FontWeight="Bold" FontSize="13" Grid.Column="1"/>
                        </Grid>
                        <Slider x:Name="SldHudFalloff" Minimum="0.70" Maximum="0.98" Value="0.88"
                                TickFrequency="0.02" IsSnapToTickEnabled="False"
                                Margin="0,2,0,4" ValueChanged="HudSetting_ValueChanged"/>
                        <TextBlock Text="Скорость гравитационного спада лучей эквалайзера за кадр (0.70 - 0.98)."
                                   FontSize="11" Foreground="#88889C" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <!-- Color Palette ComboBox -->
                        <TextBlock Text="🎨 Цветовая палитра реактора" Style="{StaticResource GroupHeaderStyle}"/>
                        <TextBlock Text="Выберите световую тему реактора:" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbHudPalette" Margin="0,0,0,14" SelectionChanged="HudSetting_ValueChanged">
                            <ComboBoxItem Content="Arc Reactor (Циан / Электрик)"/>
                            <ComboBoxItem Content="Cyberpunk Flow (Циан -> Фиолетовый -> Маджента)"/>
                            <ComboBoxItem Content="Solar Flare (Янтарь -> Оранжевый -> Неоновый красный)"/>
                            <ComboBoxItem Content="Пользовательский (Custom)"/>
                        </ComboBox>

                        <!-- Custom Colors Panel -->
                        <Border x:Name="PnlCustomColors" Background="#161622" BorderBrush="#00E5FF" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="🛠 Пользовательские цвета реактора (HEX):" FontWeight="SemiBold" Foreground="#00E5FF" Margin="0,0,0,8"/>

                                <!-- Core Color -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Цвет ядра (Core Color):" VerticalAlignment="Center" Foreground="#ECECF1"/>
                                    <TextBox x:Name="TxtCustomCoreColor" Text="#00E5FF" Grid.Column="1" Margin="0,0,6,0"
                                             TextChanged="TxtCustomColor_TextChanged"/>
                                    <Border x:Name="BrdCustomCoreColor" Grid.Column="2" Background="#00E5FF"
                                            BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Height="24"/>
                                </Grid>

                                <!-- Glow Color -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Цвет свечения (Glow Color):" VerticalAlignment="Center" Foreground="#ECECF1"/>
                                    <TextBox x:Name="TxtCustomGlowColor" Text="#0040FF" Grid.Column="1" Margin="0,0,6,0"
                                             TextChanged="TxtCustomColor_TextChanged"/>
                                    <Border x:Name="BrdCustomGlowColor" Grid.Column="2" Background="#0040FF"
                                            BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Height="24"/>
                                </Grid>

                                <!-- Rays Color -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Цвет лучей эквалайзера (Rays Color):" VerticalAlignment="Center" Foreground="#ECECF1"/>
                                    <TextBox x:Name="TxtCustomRaysColor" Text="#00FFAA" Grid.Column="1" Margin="0,0,6,0"
                                             TextChanged="TxtCustomColor_TextChanged"/>
                                    <Border x:Name="BrdCustomRaysColor" Grid.Column="2" Background="#00FFAA"
                                            BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="4" Height="24"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic Modifiers -->
                        <TextBlock Text="✨ Динамические модификаторы сияния" Style="{StaticResource GroupHeaderStyle}"/>

                        <!-- Shatter Overdrive Checkbox -->
                        <CheckBox x:Name="ChkShatterOverdrive" Content="Эффект раскола при перегрузке (Shatter Overdrive)"
                                  Foreground="#ECECF1" FontSize="13" Margin="0,4,0,4"
                                  Checked="HudSetting_ValueChanged" Unchecked="HudSetting_ValueChanged"/>
                        <TextBlock Text="Активирует кинематический разлет энергетических осколков и колец реактора при мощных басовых дропах и перегрузке."
                                   FontSize="11" Foreground="#88889C" Margin="24,0,0,14" TextWrapping="Wrap"/>

                        <!-- Color Shift Checkbox -->
                        <CheckBox x:Name="ChkColorShift" Content="Плавный перелив цвета в такт спектру (Color Shift)"
                                  Foreground="#ECECF1" FontSize="13" Margin="0,4,0,4"
                                  Checked="HudSetting_ValueChanged" Unchecked="HudSetting_ValueChanged"/>
                        <TextBlock Text="Динамический сдвиг оттенка (Hue Shift) в зависимости от текущей спектральной энергии."
                                   FontSize="11" Foreground="#88889C" Margin="24,0,0,14" TextWrapping="Wrap"/>

                        <!-- Ignore TTS in Loopback Checkbox -->
                        <CheckBox x:Name="ChkIgnoreTts" Content="Игнорировать собственный голос TTS Джарвиса при визуализации музыки"
                                  Foreground="#ECECF1" FontSize="13" Margin="0,4,0,4"
                                  Checked="HudSetting_ValueChanged" Unchecked="HudSetting_ValueChanged"/>
                        <TextBlock Text="Отсекает loopback-захват звуковой карты, когда Джарвис говорит, предотвращая ложные вспышки от собственного голоса."
                                   FontSize="11" Foreground="#88889C" Margin="24,0,0,14" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status message -->
            <TextBlock x:Name="TxtStatus"
                       Text=""
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#00FFAA"
                       Grid.Column="0"
                       Margin="0,0,12,0"/>

            <Button Content="💾 Сохранить"
                    Style="{StaticResource AccentButtonStyle}"
                    Grid.Column="1"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="BtnSave_Click"/>

            <Button Content="Закрыть"
                    Grid.Column="2"
                    Width="90"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
