<Window x:Class="Gem.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки JARVIS"
        Width="540" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="#16161A"
        Foreground="#ECECF1"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Windows 11 Dark Input Box Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#22222B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#383846"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#00D2FF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A36"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#444455"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#383848"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00D2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E1E28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#0086E6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1084D9"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#4CC2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#006CBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Group Header -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00D2FF"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A0A0B2"/>
            <Setter Property="Margin" Value="0,4,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Window Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="⚙ Настройки JARVIS" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Конфигурация LM Studio, Vosk распознавания и каталога игр Steam"
                       FontSize="12" Foreground="#888899" Margin="0,3,0,0"/>
            <Separator Background="#2A2A38" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Scrollable content area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
                <!-- Section 1: LM Studio / LLM -->
                <TextBlock Text="🤖 Модель и Сервер (LM Studio / OpenAI API)" Style="{StaticResource GroupHeaderStyle}"/>

                <TextBlock Text="API Base URL (например, http://127.0.0.1:1234/v1):" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TxtLlmUrl" Text="http://127.0.0.1:1234/v1"/>

                <TextBlock Text="Имя модели в LM Studio:" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TxtLlmModel" Text="qwen2.5-1.5b-instruct"/>

                <TextBlock Text="API Key (для LM Studio можно оставить 'lm'):" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TxtLlmApiKey" Text="lm"/>

                <!-- Section 2: Vosk Speech Recognition -->
                <TextBlock Text="🎙 Голосовое распознавание (Vosk)" Style="{StaticResource GroupHeaderStyle}"/>

                <TextBlock Text="Путь к папке модели Vosk:" Style="{StaticResource FieldLabelStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtVoskPath" Text="./model" Grid.Column="0"/>
                    <Button Content="Обзор..." Grid.Column="1" Margin="8,0,0,0" Click="BtnBrowseVosk_Click"/>
                </Grid>

                <!-- Section 3: Weather (Open-Meteo) -->
                <TextBlock Text="🌤 Погода (Open-Meteo)" Style="{StaticResource GroupHeaderStyle}"/>
                <TextBlock Text="Город (для погоды):" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="TxtCityName" Text="Санкт-Петербург"/>
                <TextBlock Text="Координаты и каноническое название определяются автоматически при сохранении."
                           FontSize="11" Foreground="#888899" Margin="0,3,0,0"/>

                <!-- Section 4: Steam Games Catalog -->
                <TextBlock Text="🎮 Привязка игр Steam (Ключ команды → Steam AppID)" Style="{StaticResource GroupHeaderStyle}"/>
                <TextBlock Text="Позволяет добавлять новые игры и команды без изменения кода C#."
                           FontSize="11" Foreground="#888899" Margin="0,0,0,6"/>

                <Border Background="#202028" BorderBrush="#383848" BorderThickness="1" CornerRadius="6" Height="150">
                    <ListView x:Name="LstSteamGames" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                              SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Ключ вызова" Width="240" DisplayMemberBinding="{Binding Key}"/>
                                <GridViewColumn Header="Steam AppID" Width="180" DisplayMemberBinding="{Binding Value}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <!-- Add new game controls -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtNewGameKey" Grid.Column="0" Margin="0,0,6,0" ToolTip="Ключ вызова (напр. 'cyberpunk')"/>
                    <TextBox x:Name="TxtNewGameAppId" Grid.Column="1" Margin="0,0,6,0" ToolTip="AppID игры в Steam (напр. '1091500')"/>
                    <Button Content="Добавить" Grid.Column="2" Margin="0,0,6,0" Click="BtnAddGame_Click"/>
                    <Button Content="Удалить" Grid.Column="3" Click="BtnRemoveGame_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status message -->
            <TextBlock x:Name="TxtStatus"
                       Text=""
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#00FFAA"
                       Grid.Column="0"/>

            <Button Content="Сохранить"
                    Style="{StaticResource AccentButtonStyle}"
                    Grid.Column="1"
                    Width="110"
                    Margin="0,0,10,0"
                    Click="BtnSave_Click"/>

            <Button Content="Закрыть"
                    Grid.Column="2"
                    Width="90"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
